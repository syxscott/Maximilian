{
  "name": "maximilian",
  "version": "0.1.0",
  "private": true,
  "description": "Maximilian - meta-agent OS",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "prepare": "husky || true",
    "demo": "pnpm --filter @max/api demo",
    "start:all": "npx concurrently -k -n api,dashboard \"META_AGENT_ENABLED=true DIGITAL_TWIN_ENABLED=true EVOLUTION_ENABLED=true TELEMETRY_ENABLED=true pnpm --filter @max/api start\" \"pnpm --filter @max/dashboard dev\"",
    "start:full": "npx concurrently -k -n api,dashboard,worker \"META_AGENT_ENABLED=true DIGITAL_TWIN_ENABLED=true EVOLUTION_ENABLED=true TELEMETRY_ENABLED=true TASK_QUEUE_ENABLED=true pnpm --filter @max/api start\" \"pnpm --filter @max/dashboard dev\" \"TASK_QUEUE_ENABLED=true pnpm --filter @max/worker start\"",
    "bootstrap": "npx tsx scripts/bootstrap-production.ts",
    "license:check": "bash scripts/check-license-headers.sh --new-only",
    "release:dry-run": "release-please release-pr --config-file=release-please-config.json --dry-run",
    "report:deprecation": "node scripts/audit-deprecated.js",
    "mutate:run": "stryker run",
    "mutate:dry": "stryker run --dryRunOnly",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:ui": "playwright test --ui",
    "docs:api": "typedoc",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "db:dry-run": "node scripts/migrate-dry-run.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o docs/storybook"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.48.0",
    "@size-limit/file": "^12.1.0",
    "@size-limit/preset-big-lib": "^12.1.0",
    "@storybook/addon-a11y": "^8.3.5",
    "@storybook/addon-essentials": "^8.3.5",
    "@storybook/addon-links": "^8.3.5",
    "@storybook/addon-themes": "^8.3.5",
    "@storybook/react": "^8.3.5",
    "@storybook/react-vite": "^8.3.5",
    "@stryker-mutator/core": "^8.5.0",
    "@stryker-mutator/vitest-runner": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "release-please": "^16.13.0",
    "size-limit": "^11.1.6",
    "storybook": "^8.3.5",
    "tsx": "^4.19.0",
    "turbo": "^2.1.3",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "cross-spawn": "^6.0.6"
    }
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
